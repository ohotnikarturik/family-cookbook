# Web (public — browser). The anon key is the client key; RLS still applies.
# Hosted env matrix: docs/DEPLOYMENT.md. Never commit real keys or SMTP passwords.
# NEXT_PUBLIC_* are inlined at `pnpm build` — set them before building staging/production.
#
# Local: `pnpm supabase:start` then `pnpm supabase:sync-env` → apps/web/.env.local
# Staging/production: separate hosted Supabase projects; HTTPS NEXT_PUBLIC_APP_URL; no service_role on the web host.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Invitation emails (T1.5 / W35.14). Local Mailpit: 127.0.0.1:54325 (see docs/LOCAL_SUPABASE.md).
# Hosted: real SMTP relay + user/password; loopback and @family-cookbook.test senders are rejected when NODE_ENV=production.
INVITATION_SMTP_HOST=
INVITATION_SMTP_PORT=
INVITATION_SMTP_FROM=
INVITATION_SMTP_USER=
INVITATION_SMTP_PASSWORD=

# Design gallery: enable /design in production builds (staging/QA). Omit in production unless needed.
# NEXT_PUBLIC_ENABLE_DESIGN_GALLERY=true

# MCP service (T4+)
MCP_PORT=8787
MCP_PUBLIC_URL=http://localhost:8787

# OAuth/JWKS (staging verification — T4.2)
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URI=

# Matches supabase/config.toml project_id (local); not a cloud project ref.
SUPABASE_PROJECT_ID=family-cookbook

# Do not add SUPABASE_SERVICE_ROLE_KEY here. App code must use the anon key + RLS.
# Local service_role is shown by `pnpm supabase:status` — keep only in gitignored .env.local if needed.
