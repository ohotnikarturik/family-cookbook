# Web (public — browser). The anon key is the client key; RLS still applies.
# Local: run `pnpm supabase:start` then `pnpm supabase:env` and paste values here.
# Defaults: URL http://127.0.0.1:54321 — anon key is project-specific (never commit real keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Invitation emails (T1.5). Local: `pnpm supabase:sync-env` writes these into apps/web/.env.local (127.0.0.1:54325 → Mailpit SMTP).
INVITATION_SMTP_HOST=
INVITATION_SMTP_PORT=
INVITATION_SMTP_FROM=

# Design gallery: enable /design in production builds (staging/QA). Omit in production unless needed.
# NEXT_PUBLIC_ENABLE_DESIGN_GALLERY=true

# MCP service (T4+)
MCP_PORT=8787
MCP_PUBLIC_URL=http://localhost:8787

# OAuth/JWKS (staging verification — T4.2)
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URI=

# Matches supabase/config.toml project_id (local); not a cloud project ref.
SUPABASE_PROJECT_ID=family-cookbook

# Do not add SUPABASE_SERVICE_ROLE_KEY here. App code must use the anon key + RLS.
# Local service_role is shown by `pnpm supabase:status` — keep only in gitignored .env.local if needed.
