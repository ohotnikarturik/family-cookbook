{
  "name": "family-cookbook",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --filter \"./packages/*\" build && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:client-bundle": "node scripts/verify-no-secrets-in-client-bundle.mjs",
    "dev:web": "pnpm --filter @family-cookbook/web dev",
    "dev:mcp": "pnpm --filter @family-cookbook/mcp dev"
  },
  "devDependencies": {
    "only-allow": "1.2.1",
    "prettier": "3.6.2"
  }
}
