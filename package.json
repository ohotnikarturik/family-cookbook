{
  "name": "family-cookbook",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --filter \"./packages/*\" build && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:client-bundle": "node scripts/verify-no-secrets-in-client-bundle.mjs",
    "dev:web": "pnpm --filter \"./packages/*\" build && pnpm --filter @family-cookbook/web dev",
    "dev:mcp": "pnpm --filter @family-cookbook/mcp dev",
    "supabase:start": "node scripts/supabase-start.mjs",
    "supabase:start:full": "supabase start",
    "supabase:start:core": "supabase start -x studio",
    "supabase:stop": "supabase stop",
    "supabase:query": "node scripts/supabase-query.mjs",
    "supabase:status": "supabase status",
    "supabase:env": "supabase status -o env",
    "supabase:sync-env": "node scripts/supabase-sync-env.mjs",
    "supabase:reset": "supabase db reset",
    "supabase:migrate": "supabase migration up",
    "supabase:test": "node scripts/supabase-test.mjs",
    "test:e2e": "pnpm --filter @family-cookbook/web test:e2e"
  },
  "devDependencies": {
    "only-allow": "1.2.1",
    "prettier": "3.6.2",
    "supabase": "3.0.0"
  }
}
